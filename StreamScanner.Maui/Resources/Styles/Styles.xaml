<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Base Page Style -->
    <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{StaticResource BgPrimary}" />
    </Style>

    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{StaticResource BgSecondary}" />
        <Setter Property="ForegroundColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="TitleColor" Value="{StaticResource TextPrimary}" />
    </Style>

    <!-- Label Styles -->
    <Style x:Key="HeaderTitle" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <Style x:Key="HeaderSubtitle" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource TextMuted}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="CharacterSpacing" Value="0.5" />
    </Style>

    <Style x:Key="LabelText" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource TextMuted}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="CharacterSpacing" Value="0.5" />
    </Style>

    <Style x:Key="StreamTitle" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
        <Setter Property="MaxLines" Value="2" />
    </Style>

    <Style x:Key="StreamMeta" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style x:Key="ViewerCount" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <Style x:Key="ViewerLabel" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource TextMuted}" />
        <Setter Property="FontSize" Value="11" />
    </Style>

    <!-- Entry Style -->
    <Style x:Key="SearchEntry" TargetType="Entry">
        <Setter Property="BackgroundColor" Value="{StaticResource BgTertiary}" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource TextMuted}" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <!-- Picker Style -->
    <Style x:Key="OptionPicker" TargetType="Picker">
        <Setter Property="BackgroundColor" Value="{StaticResource BgTertiary}" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="TitleColor" Value="{StaticResource TextMuted}" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <!-- Button Styles -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource AccentRed}" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="HeightRequest" Value="48" />
        <Setter Property="Padding" Value="24,0" />
    </Style>

    <!-- Frame Styles -->
    <Style x:Key="CardFrame" TargetType="Frame">
        <Setter Property="BackgroundColor" Value="{StaticResource BgCard}" />
        <Setter Property="BorderColor" Value="{StaticResource BorderPrimary}" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="HasShadow" Value="False" />
    </Style>

    <Style x:Key="StatusBadge" TargetType="Frame">
        <Setter Property="BackgroundColor" Value="{StaticResource BgTertiary}" />
        <Setter Property="BorderColor" Value="{StaticResource BorderPrimary}" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="HasShadow" Value="False" />
    </Style>

    <Style x:Key="LiveBadge" TargetType="Frame">
        <Setter Property="BackgroundColor" Value="{StaticResource AccentRed}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="HasShadow" Value="False" />
    </Style>

    <Style x:Key="ViewerBadge" TargetType="Frame">
        <Setter Property="BackgroundColor" Value="{StaticResource BgTertiary}" />
        <Setter Property="BorderColor" Value="{StaticResource BorderPrimary}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="HasShadow" Value="False" />
    </Style>

    <!-- Border Styles -->
    <Style x:Key="InputBorder" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource BgTertiary}" />
        <Setter Property="Stroke" Value="{StaticResource BorderPrimary}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 10" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="HeightRequest" Value="48" />
    </Style>

    <!-- ActivityIndicator -->
    <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{StaticResource AccentRed}" />
    </Style>

    <!-- Empty State -->
    <Style x:Key="EmptyStateTitle" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>

    <Style x:Key="EmptyStateText" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource TextMuted}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>

</ResourceDictionary>
