<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:StreamScanner.Maui.ViewModels"
             xmlns:models="clr-namespace:StreamScanner.Maui.Models"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="StreamScanner.Maui.Views.MainPage"
             x:DataType="viewmodels:MainViewModel"
             BackgroundColor="{StaticResource BgPrimary}">

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">

        <!-- Header -->
        <Grid Grid.Row="0"
              BackgroundColor="{StaticResource BgSecondary}"
              Padding="20,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Logo -->
            <HorizontalStackLayout Grid.Column="0" Spacing="12">
                <Border BackgroundColor="{StaticResource AccentRed}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 10"
                        WidthRequest="44"
                        HeightRequest="44">
                    <Label Text="&#9654;"
                           TextColor="White"
                           FontSize="20"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>
                <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                    <Label Text="Stream Scanner"
                           Style="{StaticResource HeaderTitle}" />
                    <Label Text="YOUTUBE LIVE DISCOVERY"
                           Style="{StaticResource HeaderSubtitle}" />
                </VerticalStackLayout>
            </HorizontalStackLayout>

            <!-- Status + Quota + Buttons -->
            <HorizontalStackLayout Grid.Column="1" Spacing="12" VerticalOptions="Center">
                <!-- Quota Badge -->
                <Border BackgroundColor="{StaticResource BgTertiary}"
                        Stroke="{StaticResource BorderPrimary}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 8"
                        Padding="10,6">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Quota"
                               TextColor="{StaticResource TextMuted}"
                               FontSize="10" />
                        <ProgressBar Progress="{Binding QuotaPercent, Converter={StaticResource PercentToProgressConverter}}"
                                     ProgressColor="{StaticResource AccentBlue}"
                                     HeightRequest="4"
                                     WidthRequest="80" />
                        <Label Text="{Binding QuotaDisplay}"
                               TextColor="{StaticResource TextSecondary}"
                               FontSize="10" />
                    </VerticalStackLayout>
                </Border>

                <Frame Style="{StaticResource StatusBadge}">
                    <Label Text="{Binding StatusMessage}"
                           TextColor="{StaticResource TextSecondary}"
                           FontSize="13" />
                </Frame>

                <!-- Favorites Button -->
                <Border BackgroundColor="{StaticResource BgTertiary}"
                        Stroke="{StaticResource BorderPrimary}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 10"
                        WidthRequest="44"
                        HeightRequest="44">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnFavoritesTapped" />
                    </Border.GestureRecognizers>
                    <Label Text="&#x2764;"
                           FontSize="18"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>

                <!-- Settings Button -->
                <Border BackgroundColor="{StaticResource BgTertiary}"
                        Stroke="{StaticResource BorderPrimary}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 10"
                        WidthRequest="44"
                        HeightRequest="44">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSettingsTapped" />
                    </Border.GestureRecognizers>
                    <Label Text="&#x2699;"
                           FontSize="18"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>
            </HorizontalStackLayout>
        </Grid>

        <!-- Tab Bar -->
        <Grid Grid.Row="1"
              BackgroundColor="{StaticResource BgSecondary}"
              Padding="20,0,20,0"
              ColumnDefinitions="*,*">
            <Button Grid.Column="0"
                    Text="Live Now"
                    Command="{Binding SwitchToLiveCommand}"
                    BackgroundColor="{Binding IsLiveTab, Converter={StaticResource BoolToTabColorConverter}}"
                    TextColor="{Binding IsLiveTab, Converter={StaticResource BoolToTabTextColorConverter}}"
                    CornerRadius="8"
                    HeightRequest="40"
                    FontSize="14"
                    FontAttributes="Bold"
                    Margin="0,0,4,8" />
            <Button Grid.Column="1"
                    Text="Upcoming"
                    Command="{Binding SwitchToUpcomingCommand}"
                    BackgroundColor="{Binding IsUpcomingTab, Converter={StaticResource BoolToTabColorConverter}}"
                    TextColor="{Binding IsUpcomingTab, Converter={StaticResource BoolToTabTextColorConverter}}"
                    CornerRadius="8"
                    HeightRequest="40"
                    FontSize="14"
                    FontAttributes="Bold"
                    Margin="4,0,0,8" />
        </Grid>

        <!-- Controls Section -->
        <ScrollView Grid.Row="2" Orientation="Vertical">
            <Grid BackgroundColor="{StaticResource BgSecondary}"
                  Padding="20,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Row 0: Search + Presets -->
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8" Margin="0,0,0,10">
                    <Border Grid.Column="0" Style="{StaticResource InputBorder}">
                        <Entry Text="{Binding Keywords}"
                               Placeholder="Enter keywords (comma-separated)"
                               Style="{StaticResource SearchEntry}"
                               ReturnCommand="{Binding ScanCommand}"
                               VerticalOptions="Center" />
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource InputBorder}" WidthRequest="120">
                        <Picker ItemsSource="{Binding PresetNames}"
                                SelectedItem="{Binding SelectedPreset}"
                                Title="Presets..."
                                Style="{StaticResource OptionPicker}"
                                VerticalOptions="Center">
                            <Picker.Behaviors>
                                <toolkit:EventToCommandBehavior
                                    EventName="SelectedIndexChanged"
                                    Command="{Binding LoadPresetCommand}"
                                    CommandParameter="{Binding SelectedPreset}" />
                            </Picker.Behaviors>
                        </Picker>
                    </Border>
                    <Button Grid.Column="2"
                            Text="Save"
                            Clicked="OnSavePresetClicked"
                            BackgroundColor="{StaticResource BgTertiary}"
                            TextColor="{StaticResource TextPrimary}"
                            BorderColor="{StaticResource BorderPrimary}"
                            BorderWidth="1"
                            CornerRadius="8"
                            HeightRequest="44"
                            FontSize="13"
                            Padding="12,0" />
                    <Button Grid.Column="3"
                            Text="Del"
                            Command="{Binding DeletePresetCommand}"
                            CommandParameter="{Binding SelectedPreset}"
                            BackgroundColor="{StaticResource BgTertiary}"
                            TextColor="{StaticResource AccentRed}"
                            BorderColor="{StaticResource BorderPrimary}"
                            BorderWidth="1"
                            CornerRadius="8"
                            HeightRequest="44"
                            FontSize="13"
                            Padding="12,0" />
                </Grid>

                <!-- Row 1: Filters row 1 (Results, Sort, Region, Language) -->
                <Grid Grid.Row="1" ColumnDefinitions="*,1.5*,*,*" ColumnSpacing="12" Margin="0,0,0,10">
                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                        <Label Text="RESULTS" Style="{StaticResource LabelText}" />
                        <Border Style="{StaticResource InputBorder}">
                            <Picker ItemsSource="{Binding MaxResultsOptions}"
                                    SelectedItem="{Binding SelectedMaxResults}"
                                    Style="{StaticResource OptionPicker}"
                                    VerticalOptions="Center" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                        <Label Text="SORT" Style="{StaticResource LabelText}" />
                        <Border Style="{StaticResource InputBorder}">
                            <Picker ItemsSource="{Binding SortOptions}"
                                    SelectedItem="{Binding SelectedSortOrder}"
                                    ItemDisplayBinding="{Binding Display}"
                                    Style="{StaticResource OptionPicker}"
                                    VerticalOptions="Center" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Column="2" Spacing="4">
                        <Label Text="REGION" Style="{StaticResource LabelText}" />
                        <Border Style="{StaticResource InputBorder}">
                            <Picker ItemsSource="{Binding RegionOptions}"
                                    SelectedItem="{Binding SelectedRegion}"
                                    ItemDisplayBinding="{Binding Display}"
                                    Style="{StaticResource OptionPicker}"
                                    VerticalOptions="Center" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Column="3" Spacing="4">
                        <Label Text="LANGUAGE" Style="{StaticResource LabelText}" />
                        <Border Style="{StaticResource InputBorder}">
                            <Picker ItemsSource="{Binding LanguageOptions}"
                                    SelectedItem="{Binding SelectedLanguage}"
                                    ItemDisplayBinding="{Binding Display}"
                                    Style="{StaticResource OptionPicker}"
                                    VerticalOptions="Center" />
                        </Border>
                    </VerticalStackLayout>
                </Grid>

                <!-- Row 2: Filters row 2 (Category, Safe Search, Min/Max Viewers) -->
                <Grid Grid.Row="2" ColumnDefinitions="1.5*,*,*,*" ColumnSpacing="12" Margin="0,0,0,10">
                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                        <Label Text="CATEGORY" Style="{StaticResource LabelText}" />
                        <Border Style="{StaticResource InputBorder}">
                            <Picker ItemsSource="{Binding TopicOptions}"
                                    SelectedItem="{Binding SelectedTopic}"
                                    ItemDisplayBinding="{Binding Display}"
                                    Style="{StaticResource OptionPicker}"
                                    VerticalOptions="Center" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                        <Label Text="SAFE SEARCH" Style="{StaticResource LabelText}" />
                        <Border Style="{StaticResource InputBorder}">
                            <Picker ItemsSource="{Binding SafeSearchOptions}"
                                    SelectedItem="{Binding SelectedSafeSearch}"
                                    ItemDisplayBinding="{Binding Display}"
                                    Style="{StaticResource OptionPicker}"
                                    VerticalOptions="Center" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Column="2" Spacing="4">
                        <Label Text="MIN VIEWERS" Style="{StaticResource LabelText}" />
                        <Border Style="{StaticResource InputBorder}">
                            <Entry Text="{Binding MinViewers}"
                                   Placeholder="0"
                                   Keyboard="Numeric"
                                   Style="{StaticResource SearchEntry}"
                                   VerticalOptions="Center" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Column="3" Spacing="4">
                        <Label Text="MAX VIEWERS" Style="{StaticResource LabelText}" />
                        <Border Style="{StaticResource InputBorder}">
                            <Entry Text="{Binding MaxViewers}"
                                   Placeholder="No limit"
                                   Keyboard="Numeric"
                                   Style="{StaticResource SearchEntry}"
                                   VerticalOptions="Center" />
                        </Border>
                    </VerticalStackLayout>
                </Grid>

                <!-- Row 3: Refresh + Scan/Stop -->
                <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12" Margin="0,0,0,10">
                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                        <Label Text="AUTO-REFRESH" Style="{StaticResource LabelText}" />
                        <Border Style="{StaticResource InputBorder}">
                            <Picker ItemsSource="{Binding RefreshOptions}"
                                    ItemDisplayBinding="{Binding Display}"
                                    SelectedItem="{Binding SelectedRefreshInterval, Converter={StaticResource RefreshOptionConverter}}"
                                    Style="{StaticResource OptionPicker}"
                                    VerticalOptions="Center" />
                        </Border>
                    </VerticalStackLayout>

                    <BoxView Grid.Column="1" />

                    <Button Grid.Column="2"
                            Text="Scan Now"
                            Command="{Binding ScanCommand}"
                            IsEnabled="{Binding IsScanning, Converter={toolkit:InvertedBoolConverter}}"
                            Style="{StaticResource PrimaryButton}" />
                    <Button Grid.Column="3"
                            Text="Stop"
                            Command="{Binding StopScanCommand}"
                            IsEnabled="{Binding IsScanning}"
                            BackgroundColor="{StaticResource BgTertiary}"
                            TextColor="{StaticResource TextPrimary}"
                            BorderColor="{StaticResource BorderPrimary}"
                            BorderWidth="1"
                            CornerRadius="10"
                            HeightRequest="44"
                            WidthRequest="80" />
                </Grid>

                <!-- Row 4: Blocked Channels Bar -->
                <Grid Grid.Row="4"
                      IsVisible="{Binding HasBlockedChannels}"
                      ColumnDefinitions="Auto,*,Auto"
                      ColumnSpacing="8">
                    <Label Grid.Column="0"
                           Text="Blocked:"
                           TextColor="{StaticResource TextMuted}"
                           FontSize="12"
                           VerticalOptions="Center" />
                    <CollectionView Grid.Column="1"
                                    ItemsSource="{Binding BlockedChannels}"
                                    HeightRequest="32">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Horizontal" ItemSpacing="6" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Border BackgroundColor="{StaticResource BgTertiary}"
                                        Stroke="{StaticResource BorderPrimary}"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 12"
                                        Padding="8,2"
                                        HeightRequest="28">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:MainViewModel}}, Path=UnblockChannelCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <HorizontalStackLayout Spacing="4">
                                        <Label Text="{Binding .}"
                                               TextColor="{StaticResource TextSecondary}"
                                               FontSize="11"
                                               VerticalOptions="Center" />
                                        <Label Text="x"
                                               TextColor="{StaticResource TextMuted}"
                                               FontSize="11"
                                               FontAttributes="Bold"
                                               VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                    <Button Grid.Column="2"
                            Text="Clear All"
                            Command="{Binding ClearBlockedChannelsCommand}"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource AccentRed}"
                            FontSize="11"
                            HeightRequest="28"
                            Padding="8,0" />
                </Grid>
            </Grid>
        </ScrollView>

        <!-- Results Area -->
        <Grid Grid.Row="3" Padding="20,16">

            <!-- Empty State -->
            <VerticalStackLayout IsVisible="{Binding ShowEmptyState}"
                                 VerticalOptions="Center"
                                 HorizontalOptions="Center"
                                 Spacing="12">
                <Label Text="&#x1F4FA;"
                       FontSize="60"
                       HorizontalOptions="Center"
                       Opacity="0.5" />
                <Label Text="Ready to Scan"
                       Style="{StaticResource EmptyStateTitle}" />
                <Label Text="Enter keywords and tap Scan Now to discover live streams"
                       Style="{StaticResource EmptyStateText}" />
            </VerticalStackLayout>

            <!-- No Results State -->
            <VerticalStackLayout IsVisible="{Binding ShowNoResults}"
                                 VerticalOptions="Center"
                                 HorizontalOptions="Center"
                                 Spacing="12">
                <Label Text="&#x1F50D;"
                       FontSize="60"
                       HorizontalOptions="Center"
                       Opacity="0.5" />
                <Label Text="No Streams Found"
                       Style="{StaticResource EmptyStateTitle}" />
                <Label Text="Try different keywords or check back later"
                       Style="{StaticResource EmptyStateText}" />
            </VerticalStackLayout>

            <!-- Loading Indicator -->
            <ActivityIndicator IsRunning="{Binding IsScanning}"
                               IsVisible="{Binding IsScanning}"
                               HeightRequest="50"
                               WidthRequest="50"
                               VerticalOptions="Center"
                               HorizontalOptions="Center" />

            <!-- Results List -->
            <CollectionView ItemsSource="{Binding Streams}"
                            IsVisible="{Binding HasResults}">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="viewmodels:LiveStreamItem">
                        <Frame Style="{StaticResource CardFrame}">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:MainViewModel}}, Path=OpenStreamCommand}"
                                    CommandParameter="{Binding .}" />
                            </Frame.GestureRecognizers>

                            <Grid ColumnDefinitions="160,*,Auto,Auto,Auto,Auto" ColumnSpacing="12">

                                <!-- Thumbnail -->
                                <Grid Grid.Column="0">
                                    <Border StrokeThickness="0"
                                            StrokeShape="RoundRectangle 10"
                                            HeightRequest="90">
                                        <Image Source="{Binding Stream.ThumbnailUrl}"
                                               Aspect="AspectFill" />
                                    </Border>

                                    <!-- Live Badge -->
                                    <Frame Style="{StaticResource LiveBadge}"
                                           HorizontalOptions="Start"
                                           VerticalOptions="Start"
                                           Margin="8"
                                           IsVisible="{Binding Stream.IsUpcoming, Converter={toolkit:InvertedBoolConverter}}">
                                        <HorizontalStackLayout Spacing="6">
                                            <Ellipse Fill="White"
                                                     WidthRequest="6"
                                                     HeightRequest="6" />
                                            <Label Text="LIVE"
                                                   TextColor="White"
                                                   FontSize="10"
                                                   FontAttributes="Bold"
                                                   CharacterSpacing="0.5" />
                                        </HorizontalStackLayout>
                                    </Frame>

                                    <!-- Upcoming Badge -->
                                    <Frame BackgroundColor="#7C3AED"
                                           CornerRadius="4"
                                           Padding="6,3"
                                           HasShadow="False"
                                           HorizontalOptions="Start"
                                           VerticalOptions="Start"
                                           Margin="8"
                                           IsVisible="{Binding Stream.IsUpcoming}">
                                        <Label Text="UPCOMING"
                                               TextColor="White"
                                               FontSize="10"
                                               FontAttributes="Bold" />
                                    </Frame>
                                </Grid>

                                <!-- Stream Info -->
                                <VerticalStackLayout Grid.Column="1"
                                                     VerticalOptions="Center"
                                                     Spacing="6">
                                    <Label Text="{Binding Stream.Title}"
                                           Style="{StaticResource StreamTitle}" />
                                    <HorizontalStackLayout Spacing="6">
                                        <Label Text="&#x1F464;"
                                               FontSize="12" />
                                        <Label Text="{Binding Stream.ChannelTitle}"
                                               Style="{StaticResource StreamMeta}" />
                                    </HorizontalStackLayout>
                                    <HorizontalStackLayout Spacing="6">
                                        <Label Text="&#x1F550;"
                                               FontSize="12" />
                                        <Label Text="{Binding Stream.StartTimeDisplay, StringFormat='Started {0}'}"
                                               Style="{StaticResource StreamMeta}"
                                               IsVisible="{Binding Stream.IsUpcoming, Converter={toolkit:InvertedBoolConverter}}" />
                                        <Label Text="{Binding Stream.ScheduledTimeDisplay}"
                                               Style="{StaticResource StreamMeta}"
                                               IsVisible="{Binding Stream.IsUpcoming}" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>

                                <!-- Copy Link Button -->
                                <Border Grid.Column="2"
                                        BackgroundColor="{StaticResource BgTertiary}"
                                        Stroke="{StaticResource BorderPrimary}"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 10"
                                        WidthRequest="40"
                                        HeightRequest="40"
                                        VerticalOptions="Center">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:MainViewModel}}, Path=CopyLinkCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Label Text="&#x1F4CB;"
                                           FontSize="14"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Border>

                                <!-- Favorite Button -->
                                <Border Grid.Column="3"
                                        BackgroundColor="{StaticResource BgTertiary}"
                                        Stroke="{StaticResource BorderPrimary}"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 10"
                                        WidthRequest="40"
                                        HeightRequest="40"
                                        VerticalOptions="Center">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:MainViewModel}}, Path=ToggleFavoriteCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Label Text="{Binding FavoriteIcon}"
                                           FontSize="16"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Border>

                                <!-- Block Channel Button -->
                                <Border Grid.Column="4"
                                        BackgroundColor="{StaticResource BgTertiary}"
                                        Stroke="{StaticResource BorderPrimary}"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 10"
                                        WidthRequest="40"
                                        HeightRequest="40"
                                        VerticalOptions="Center">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:MainViewModel}}, Path=BlockChannelCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Label Text="&#x1F6AB;"
                                           FontSize="14"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Border>

                                <!-- Viewer Count / Scheduled Time -->
                                <Frame Grid.Column="5"
                                       Style="{StaticResource ViewerBadge}"
                                       VerticalOptions="Center">
                                    <HorizontalStackLayout Spacing="8">
                                        <Label Text="&#x1F465;"
                                               FontSize="14"
                                               TextColor="{StaticResource AccentRed}"
                                               IsVisible="{Binding Stream.IsUpcoming, Converter={toolkit:InvertedBoolConverter}}" />
                                        <Label Text="&#x1F4C5;"
                                               FontSize="14"
                                               TextColor="#7C3AED"
                                               IsVisible="{Binding Stream.IsUpcoming}" />
                                        <VerticalStackLayout>
                                            <Label Text="{Binding Stream.ViewerCountDisplay}"
                                                   Style="{StaticResource ViewerCount}"
                                                   IsVisible="{Binding Stream.IsUpcoming, Converter={toolkit:InvertedBoolConverter}}" />
                                            <Label Text="viewers"
                                                   Style="{StaticResource ViewerLabel}"
                                                   IsVisible="{Binding Stream.IsUpcoming, Converter={toolkit:InvertedBoolConverter}}" />
                                            <Label Text="{Binding Stream.ScheduledTimeDisplay}"
                                                   Style="{StaticResource ViewerCount}"
                                                   IsVisible="{Binding Stream.IsUpcoming}" />
                                            <Label Text="scheduled"
                                                   Style="{StaticResource ViewerLabel}"
                                                   IsVisible="{Binding Stream.IsUpcoming}" />
                                        </VerticalStackLayout>
                                    </HorizontalStackLayout>
                                </Frame>

                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <!-- Footer -->
        <Grid Grid.Row="4"
              BackgroundColor="{StaticResource BgSecondary}"
              Padding="20,16">
            <Label Text="Powered by YouTube Data API v3"
                   TextColor="{StaticResource TextMuted}"
                   FontSize="12"
                   HorizontalOptions="Center" />
        </Grid>

    </Grid>
</ContentPage>
