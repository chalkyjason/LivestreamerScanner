<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:StreamScanner.Maui.Converters"
             x:Class="StreamScanner.Maui.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters -->
            <converters:RefreshOptionConverter x:Key="RefreshOptionConverter" />
            <converters:BoolToTabColorConverter x:Key="BoolToTabColorConverter" />
            <converters:BoolToTabTextColorConverter x:Key="BoolToTabTextColorConverter" />
            <converters:PercentToProgressConverter x:Key="PercentToProgressConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
